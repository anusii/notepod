# 20260923 gjw macos/Runner/Info.plist is NOT ignored for RadioPod, unlike
# the other apps in the suite. It carries NSAppTransportSecurity, without
# which macOS blocks the plain http:// streams that a large share of radio
# stations still use, and playback fails with AVFoundation error -11800.
#
# The build regenerates the macOS project with `flutter create`, which
# CREATES a missing Info.plist but leaves an existing one alone (verified).
# So the file has to be in the repository: while it was ignored, every CI
# clone started without it and got Apple's default, with ATS enforced.

# Backups of ios/macos project config yml and Podfile
macos/Podfile-*
macos/project-*.yml

/macos/Podfile.lock
/macos/.gitignore
/macos/Podfile
/macos/Flutter/
/macos/Runner.xcworkspace/
/macos/RunnerTests/
/macos/Runner/AppDelegate.swift
/macos/Runner/MainFlutterWindow.swift
/macos/Runner/Base.lproj/
/macos/Runner/Configs/

# 20260923 gjw macos/Runner/Assets.xcassets/ is NOT ignored, for the same
# reason as Info.plist above: it holds the app ICON. `dart run
# flutter_launcher_icons` writes it here from assets/images/app_icon.png,
# but while it was ignored those icons never reached the repository, so
# every CI clone regenerated the macOS project with `flutter create` and
# shipped Flutter's default blue logo instead. macOS was the only platform
# with this gap — android, ios, web, windows and snap all track their icons.
#
# Re-run `dart run flutter_launcher_icons` and commit the result whenever
# assets/images/app_icon.png changes.

