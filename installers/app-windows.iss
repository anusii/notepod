; Script manually built from one generated by Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
;
; From the gjwgit/fluttertmpl Copier template, with the name, publisher
; and AppId from .copier-answers.yml. Local edits are kept by `copier
; update`.

#define MyAppName "NotePod"
#define MyAppPublisher "Software Innovation Institute ANU"
#define MyAppURL "https://github.com/anusii/notepod"
#define MyAppExeName "notepod.exe"

; 20261030 gjw The version is the one the workflow reads from
; pubspec.yaml into APP_VERSION. It becomes the DisplayVersion in
; Apps & Features, which winget compares against the PackageVersion of
; its manifest, so it must be the real version and not a label. Fail
; the build rather than ship an installer without it.

#define MyAppVersion GetEnv("APP_VERSION")
#if MyAppVersion == ""
  #error APP_VERSION is not set. See the workflow's Get Version step.
#endif

[Setup]
;
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
; (On Ubuntu run `uuidgen` to generate a unique AppId.)
;
; Also notice the consecutive "{" characters required, it seems. Looks
; like it is for embedding a single "{" and not a constant.
;
; 20261030 gjw The AppId must never change once released, or Windows
; treats the next version as a different app.
;
AppId={{6B5EF861-CA64-4E55-91B0-1ED4544ABF98}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;
; 20261030 gjw Without this Apps & Features lists "NotePod version
; 1.2.3", and winget matches installed apps by a DisplayName that does
; not change from one version to the next.
;
UninstallDisplayName={#MyAppName}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DisableProgramGroupPage=yes
LicenseFile=..\LICENSE
;
; Uncomment the following line to run in non administrative install mode
; (install for current user only.) Otherwise it runs as admin to install
; for all users.
;
;PrivilegesRequired=lowest
;
; If the following is `dialog` then when installed from the command line the
; user is prompted through a POPUP to install for current user or system.
; By setting it to `commandline` then from the command line the choice can
; be `/ALLUSERS` or `/CURRENTUSER`. The default is `/ALLUSERS`.
;
;PrivilegesRequiredOverridesAllowed=dialog
;
PrivilegesRequiredOverridesAllowed=commandline
OutputDir=installers
;
; 20261030 gjw A fixed name, now that MyAppVersion is the real version,
; since the workflow uploads notepod-windows-inno.exe.
;
OutputBaseFilename=notepod-windows-inno
SetupIconFile=..\windows\runner\resources\app_icon.ico
Compression=lzma
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

; Check the DIR command in the workflow to see what DLLs get generated.

[Files]
Source: "..\build\windows\x64\runner\Release\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\build\windows\x64\runner\Release\*.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\build\windows\x64\runner\Release\data\*"; DestDir: "{app}\data"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
